---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PillarGrid from '../components/PillarGrid.astro';
import BlogCard from '../components/BlogCard.astro';

const description =
  'A community ecosystem for building retro computers. Shared bus standards, portable drivers, FPGA hardware, and classic software — mixed, matched, and brought back to life.';

const base = import.meta.env.BASE_URL;

const latestPosts = (
  await getCollection('blog', ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<PageLayout title="Home" description={description}>
  <Hero />
  <PillarGrid />

  <section class="latest" aria-labelledby="latest-heading">
    <header class="latest-header">
      <p class="latest-kicker" aria-hidden="true">// news</p>
      <div class="latest-title-row">
        <h2 id="latest-heading" class="latest-heading">Latest Posts</h2>
        <a class="latest-view-all" href={`${base}blog/`}>View all &rarr;</a>
      </div>
    </header>

    {latestPosts.length === 0 ? (
      <pre class="terminal" aria-label="Blog placeholder">
<span class="term-prompt">&gt;</span> blog coming soon &mdash; check back after first commits are published
      </pre>
    ) : (
      <ul class="post-grid" role="list">
        {latestPosts.map((entry) => (
          <li class="post-grid-item">
            <BlogCard entry={entry} />
          </li>
        ))}
      </ul>
    )}
  </section>
</PageLayout>

<style>
  .latest {
    margin-block: var(--space-48) var(--space-32);
  }

  .latest-header {
    margin-bottom: var(--space-24);
  }

  .latest-kicker {
    font-family: var(--font-mono);
    color: var(--color-muted);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-8) 0;
  }

  .latest-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
  }

  .latest-heading {
    font-family: var(--font-heading);
    color: var(--color-accent);
    font-size: 1.75rem;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .latest-view-all {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .latest-view-all:hover,
  .latest-view-all:focus {
    color: var(--color-accent-alt);
  }

  @media (min-width: 768px) {
    .latest-heading {
      font-size: 2rem;
    }
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-24);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-grid-item {
    display: flex;
  }

  .post-grid-item > :global(*) {
    flex: 1 1 auto;
    width: 100%;
  }

  @media (min-width: 768px) {
    .post-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-24);
    }
  }

  @media (min-width: 1024px) {
    .post-grid {
      gap: var(--space-32);
    }
  }

  .terminal {
    font-family: var(--font-mono);
    color: var(--color-muted);
    background-color: color-mix(in srgb, var(--color-accent) 3%, var(--color-bg));
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: var(--space-16) var(--space-24);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .term-prompt {
    color: var(--color-accent);
    margin-right: 0.4em;
  }
</style>
