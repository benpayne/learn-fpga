---
// Header.astro — Responsive primary navigation. No JavaScript; mobile uses
// native <details> disclosure. Active page receives aria-current="page".
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}architecture/`, label: 'Architecture' },
  { href: `${base}getting-started/`, label: 'Getting Started' },
  { href: `${base}projects/`, label: 'Projects' },
  { href: `${base}blog/`, label: 'Blog' },
];

// Normalize current pathname for comparison; Astro.url.pathname already
// honors trailingSlash config.
const currentPath = Astro.url.pathname;

function isCurrent(href: string): boolean {
  // Exact match covers the normal case with trailingSlash:'always'.
  if (href === currentPath) return true;
  // Also match paths where trailing slash differs.
  const hrefNoSlash = href.replace(/\/$/, '');
  const curNoSlash = currentPath.replace(/\/$/, '');
  return hrefNoSlash === curNoSlash;
}

const brandHref = base;
const brandIsCurrent = isCurrent(brandHref);
---

<header class="site-header">
  <nav aria-label="Primary" class="site-nav">
    <a
      href={brandHref}
      class="brand"
      aria-current={brandIsCurrent ? 'page' : undefined}
    >
      Retro-Active
    </a>

    {/* Mobile disclosure: native <details>, no JS. */}
    <details class="mobile-disclosure">
      <summary aria-label="Toggle navigation menu">
        <span aria-hidden="true">&#9776;</span>
        <span class="menu-word">Menu</span>
      </summary>
      <ul class="nav-list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    {/* Desktop horizontal list (shown >= 768px via CSS) */}
    <ul class="nav-list desktop-nav" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav {
    max-width: var(--max-layout);
    margin-inline: auto;
    padding: var(--space-16) var(--space-16);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .brand:hover,
  .brand:focus {
    color: var(--color-accent-alt);
    text-decoration: none;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-16);
    flex-wrap: wrap;
  }

  .nav-list a {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-4) var(--space-8);
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .nav-list a:hover,
  .nav-list a:focus {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    text-decoration: none;
  }

  .nav-list a[aria-current='page'] {
    color: var(--color-accent-alt);
    border-bottom-color: var(--color-accent-alt);
  }

  /* Mobile disclosure */
  .mobile-disclosure {
    color: var(--color-text);
    font-family: var(--font-heading);
  }

  .mobile-disclosure summary {
    cursor: pointer;
    list-style: none;
    padding: var(--space-8) var(--space-12);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    user-select: none;
  }

  .mobile-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .mobile-disclosure summary:focus-visible {
    outline: 2px solid var(--color-accent-alt);
    outline-offset: 2px;
  }

  .mobile-disclosure .menu-word {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .mobile-disclosure[open] .nav-list {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
    margin-top: var(--space-12);
    width: 100%;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }

  /* Hide the desktop nav list on small screens */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-disclosure {
      display: none;
    }

    .desktop-nav {
      display: flex;
    }
  }
</style>
