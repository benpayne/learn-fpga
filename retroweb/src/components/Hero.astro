---
// Hero.astro — Landing page hero with CRT terminal styling.
// Large project name, tagline, and two CTAs. No JavaScript; the cursor
// blink is pure CSS and is disabled by prefers-reduced-motion.
const base = import.meta.env.BASE_URL;

const aboutHref = `${base}about/`;
const startedHref = `${base}getting-started/`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <p class="prompt" aria-hidden="true">
      <span class="prompt-sigil">&gt;</span>
      <span class="prompt-text">ready</span><span class="prompt-cursor">_</span>
    </p>

    <h1 id="hero-title" class="hero-title">Retro-Active</h1>

    <p class="tagline">
      A community ecosystem for hobbyists building new computers in the
      spirit of the 8-, 16-, or even 32-bit era. Discrete logic, PAL/GAL,
      or FPGA &mdash; whatever you build with, shared bus standards and
      portable drivers let your work plug into everyone else&rsquo;s.
    </p>

    <div class="cta-row">
      <a class="cta cta-primary" href={aboutHref}>Read the Vision</a>
      <a class="cta cta-secondary" href={startedHref}>Get Started</a>
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    padding-block: var(--space-48);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: var(--max-layout);
    margin-inline: auto;
    padding-inline: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* Terminal prompt decoration */
  .prompt {
    font-family: var(--font-mono);
    color: var(--color-muted);
    font-size: 0.95rem;
    margin: 0;
    letter-spacing: 0.05em;
  }

  .prompt-sigil {
    color: var(--color-accent);
    margin-right: 0.4em;
  }

  .prompt-text {
    color: var(--color-accent);
  }

  .prompt-cursor {
    display: inline-block;
    color: var(--color-accent);
    animation: blink 1.1s steps(2, end) infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-cursor {
      animation: none;
      opacity: 1;
    }
  }

  /* CRT-style heading */
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    font-size: clamp(2.5rem, 6vw + 1rem, 5.5rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0;
    text-shadow:
      0 0 2px rgba(127, 255, 127, 0.6),
      0 0 10px rgba(127, 255, 127, 0.25),
      0 0 22px rgba(127, 255, 127, 0.12);
  }

  .tagline {
    font-family: var(--font-body);
    color: var(--color-text);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 60ch;
    margin: 0;
  }

  @media (min-width: 768px) {
    .tagline {
      font-size: 1.25rem;
    }
  }

  /* CTAs */
  .cta-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  @media (min-width: 480px) {
    .cta-row {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-16);
    }
  }

  .cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-12) var(--space-24);
    border: 1px solid currentColor;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .cta-primary {
    color: var(--color-bg);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .cta-primary:hover,
  .cta-primary:focus {
    color: var(--color-bg);
    background-color: var(--color-accent-alt);
    border-color: var(--color-accent-alt);
    text-decoration: none;
  }

  .cta-secondary {
    color: var(--color-accent);
    background-color: transparent;
    border-color: var(--color-accent);
  }

  .cta-secondary:hover,
  .cta-secondary:focus {
    color: var(--color-accent-alt);
    border-color: var(--color-accent-alt);
    background-color: rgba(255, 176, 0, 0.06);
    text-decoration: none;
  }

  .cta:focus-visible {
    outline: 2px solid var(--color-accent-alt);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-64);
    }

    .hero-inner {
      padding-inline: var(--space-24);
      gap: var(--space-32);
    }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      padding-inline: var(--space-32);
    }
  }
</style>
