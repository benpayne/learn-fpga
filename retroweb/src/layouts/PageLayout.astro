---
// PageLayout.astro — Static page wrapper: BaseLayout + Header + main + Footer.
// Adds a skip-to-main-content link for keyboard users.
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: var(--max-layout);
    margin-inline: auto;
    padding-inline: var(--space-16);
    padding-block: var(--space-32);
    min-height: 60vh;
  }

  @media (min-width: 768px) {
    main {
      padding-inline: var(--space-24);
    }
  }

  @media (min-width: 1024px) {
    main {
      padding-inline: var(--space-32);
    }
  }

  /* Skip-to-content link: visually hidden until focused. */
  .skip-link {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    background: var(--color-bg);
    color: var(--color-accent);
    font-family: var(--font-heading);
    z-index: 1000;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    padding: var(--space-8) var(--space-16);
    outline: 2px solid var(--color-accent-alt);
    outline-offset: 2px;
    text-decoration: underline;
    display: inline-block;
  }
</style>
