# Colorlight i5 v7.0 + carrier board constraint file for FM Synth

## Clock (25 MHz) ###################################

LOCATE COMP "clk_i" SITE "P3";
IOBUF  PORT "clk_i" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_i" 25 MHZ;

## On-module LED (active-low) #######################

LOCATE COMP "led_o" SITE "N18";
IOBUF  PORT "led_o" IO_TYPE=LVCMOS33;

## Note buttons (active-low, pressed = GND) ##########
# 4 buttons for notes: C4, E4, G4, C5

LOCATE COMP "btn[0]" SITE "R1";    # Button 0 -> C4
LOCATE COMP "btn[1]" SITE "U1";    # Button 1 -> E4
LOCATE COMP "btn[2]" SITE "V1";    # Button 2 -> G4
LOCATE COMP "btn[3]" SITE "N2";    # Button 3 -> C5

IOBUF  PORT "btn[0]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[1]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[2]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[3]" PULLMODE=UP IO_TYPE=LVCMOS33;

## Voice switches (active-low) #######################
# 3 switches select voice/timbre (T1 is system reset, skip it)
# Unused sw[3] directly driven in HDL

LOCATE COMP "sw[0]" SITE "Y2";
LOCATE COMP "sw[1]" SITE "W1";
LOCATE COMP "sw[2]" SITE "M1";

IOBUF  PORT "sw[0]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "sw[1]" PULLMODE=UP IO_TYPE=LVCMOS33;
IOBUF  PORT "sw[2]" PULLMODE=UP IO_TYPE=LVCMOS33;

## Audio PWM output ##################################
# Connect speaker/amp between this pin and GND
# Use a series resistor (100-330 ohm) for a speaker

LOCATE COMP "audio_out" SITE "J18";
IOBUF  PORT "audio_out" IO_TYPE=LVCMOS33 DRIVE=4;
